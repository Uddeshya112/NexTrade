POSTGRES_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_KEY_ID_CURRENT=key-1
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXTRADE_EMAIL_VERIFICATION_ENABLED=false
# SMTP credentials are only needed when enabling verification email.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-smtp-username
# SPRING_MAIL_PASSWORD=your-smtp-password
# NEXTRADE_MAIL_FROM=verified-sender@example.com
